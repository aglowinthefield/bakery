{
  "name": "bakery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "bakery-cli": "./scripts/bakery-cli.mjs"
  },
  "scripts": {
    "dev": "concurrently -k \"node scripts/dev-server.mjs\" \"vite --host 127.0.0.1\"",
    "build": "npm run format:check && tsc -b && vite build",
    "start": "tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "bakery": "node scripts/bakery-cli.mjs",
    "format": "prettier --write src/main.tsx src/card-details.tsx src/review.tsx src/attempts.tsx src/api.ts src/model.ts src/markdown.ts src/markdown-view.tsx src/usage.ts",
    "format:check": "prettier --check src/main.tsx src/card-details.tsx src/review.tsx src/attempts.tsx src/api.ts src/model.ts src/markdown.ts src/markdown-view.tsx src/usage.ts"
  },
  "dependencies": {
    "@pierre/diffs": "^1.6.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/vite": "^4.1.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.12.0",
    "lucide-react": "^0.548.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.16"
  },
  "devDependencies": {
    "@types/node": "^24.9.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.1",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
